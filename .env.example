APP_NAME=EduJob
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=edujob
DB_USERNAME=edujob
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ИИ-скрининг, парсинг резюме, двуязычная генерация (см. ARCHITECTURE.md §2)
ANTHROPIC_API_KEY=

# SMS-шлюз для OTP-авторизации по телефону. driver=log — код пишется в
# лог вместо реальной отправки (dev/CI); driver=nikita — боевой
# smspro.nikita.kg. Реальный провайдер подключается отдельным классом за
# App\Services\Sms\SmsGateway, без смены вызывающего кода.
SMS_GATEWAY_DRIVER=log
SMS_OTP_RATE_LIMIT_PER_DAY=5
TEST_PHONE_NUMBERS=

# smspro.nikita.kg (XML/HTTP-протокол) — заполняется на проде/staging.
NIKITA_SMS_BASE_URL=https://smspro.nikita.kg/api
NIKITA_SMS_LOGIN=
NIKITA_SMS_PASSWORD=
NIKITA_SMS_SENDER=EduJob
NIKITA_SMS_TEST_MODE=

# Telegram-бот — второй канал уведомлений, не единственный способ входа
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
